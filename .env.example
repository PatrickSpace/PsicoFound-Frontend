VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_FUNCTIONS_REGION=southamerica-east1

# Activa solo si Web Analytics esta habilitado y el frontend se sirve desde Vercel.
VITE_VERCEL_ANALYTICS_ENABLED=false

# Opcional: descomenta para cambiar el número público de soporte de Lurems.
# Incluye el código de país sin espacios. Un valor vacío oculta el botón.
# VITE_SUPPORT_WHATSAPP_NUMBER=

# Pagos fase 1: los enlaces se administran en Firestore, no en variables VITE_.
# Nunca agregues secretos del backend a este archivo.
VITE_LEGAL_DOCUMENT_VERSION=
VITE_TERMS_URL=
VITE_PRIVACY_URL=

# Optional public reCAPTCHA Enterprise site key override. Production has a
# project-scoped public fallback in src/config/appCheck.js. Other projects need
# their own key. Never use a debug token in production.
VITE_APP_CHECK_SITE_KEY=

# Optional automatic payment provider configuration.
VITE_FIREBASE_APPCHECK_SITE_KEY=
VITE_FIREBASE_APPCHECK_DEBUG=false
VITE_APP_ENVIRONMENT=development
VITE_APP_BASE_URL=http://localhost:5173
VITE_PAYMENT_PROVIDER=culqi
VITE_PAYMENT_ENVIRONMENT=sandbox
VITE_PAYMENT_USE_FAKE_PROVIDER=true
VITE_MERCADO_PAGO_PUBLIC_KEY=TEST-REEMPLAZAR_PUBLIC_KEY
VITE_CULQI_PUBLIC_KEY=pk_test_REEMPLAZAR

# Enable the configurable calendar after deploying its server APIs.
VITE_CALENDAR_ENABLED=false
