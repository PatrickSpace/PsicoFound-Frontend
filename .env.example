VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_FUNCTIONS_REGION=southamerica-east1

# Activa solo si Web Analytics esta habilitado y el frontend se sirve desde Vercel.
VITE_VERCEL_ANALYTICS_ENABLED=false

# Pagos fase 1: los enlaces se administran en Firestore, no en variables VITE_.
# Nunca agregues secretos del backend a este archivo.
VITE_LEGAL_DOCUMENT_VERSION=
VITE_TERMS_URL=
VITE_PRIVACY_URL=

# Optional public reCAPTCHA Enterprise site key override. Production has a
# project-scoped public fallback in src/config/appCheck.js. Other projects need
# their own key. Never use a debug token in production.
VITE_APP_CHECK_SITE_KEY=
