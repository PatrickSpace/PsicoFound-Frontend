rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null &&
        (!exists(/databases/$(database)/documents/account_requests/$(request.auth.uid + '_deletion')) ||
          get(/databases/$(database)/documents/account_requests/$(request.auth.uid + '_deletion')).data.get('accessBlocked', false) != true) &&
        (!exists(/databases/$(database)/documents/runtime_controls/maintenance) ||
          get(/databases/$(database)/documents/runtime_controls/maintenance).data.enabled != true);
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function currentUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userHasRole(role) {
      return signedIn() &&
        currentUserDoc().data.roles is list &&
        currentUserDoc().data.roles.hasAny([role]);
    }

    function isAdmin() {
      return signedIn() &&
        (
          currentUserDoc().data.get('roles', []).hasAny(["admin", "psicofound-admin"]) ||
          currentUserDoc().data.get('rol', '') in ["admin", "psicofound-admin"] ||
          currentUserDoc().data.get('role', '') in ["admin", "psicofound-admin"]
        );
    }

    function isPatientRole(role) {
      return role in ["paciente", "patient"];
    }

    function isPatientRoles(roles) {
      return roles is list && roles.hasOnly(["patient"]) && roles.hasAll(["patient"]);
    }

    function validSelfUserCreate(uid) {
      return isOwner(uid) &&
        request.resource.data.id == uid &&
        request.resource.data.email is string &&
        request.resource.data.nombre is string &&
        isPatientRole(request.resource.data.rol) &&
        isPatientRoles(request.resource.data.roles) &&
        request.resource.data.keys().hasOnly([
          "id",
          "email",
          "nombre",
          "rol",
          "roles",
          "createdAt",
          "updatedAt"
        ]);
    }

    function ownsExistingPatientDoc() {
      return signedIn() && resource.data.pacienteUid == request.auth.uid;
    }

    function ownsIncomingPatientDoc() {
      return signedIn() && request.resource.data.pacienteUid == request.auth.uid;
    }

    function assignedTherapist(therapistId) {
      return signedIn() &&
        (userHasRole("psychologist") || currentUserDoc().data.rol == "psicologo") &&
        exists(/databases/$(database)/documents/therapists/$(therapistId)) &&
        get(/databases/$(database)/documents/therapists/$(therapistId)).data.get("activo", true) == true &&
        get(/databases/$(database)/documents/therapists/$(therapistId)).data.uid ==
          request.auth.uid;
    }

    function ownsExistingTherapistDoc() {
      return signedIn() && assignedTherapist(resource.data.terapeutaId);
    }

    function ownsIncomingTherapistDoc() {
      return signedIn() &&
        request.resource.data.terapeutaId == resource.data.terapeutaId &&
        assignedTherapist(request.resource.data.terapeutaId);
    }

    function assignedTherapistForTherapy(therapyId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/terapias/$(therapyId)) &&
        assignedTherapist(
          get(/databases/$(database)/documents/terapias/$(therapyId))
            .data.terapeutaId
        );
    }

    function canReadTherapy(therapyId) {
      return signedIn() && therapyId is string && therapyId != "" &&
        exists(/databases/$(database)/documents/terapias/$(therapyId)) &&
        (get(/databases/$(database)/documents/terapias/$(therapyId)).data.pacienteUid == request.auth.uid ||
          assignedTherapistForTherapy(therapyId));
    }

    function incomingNotificationHasTherapy() {
      return request.resource.data.metadata is map &&
        request.resource.data.metadata.terapiaId is string &&
        request.resource.data.metadata.terapiaId != "" &&
        exists(
          /databases/$(database)/documents/terapias/$(request.resource.data.metadata.terapiaId)
        );
    }

    function incomingNotificationFromPatientToTherapist() {
      return incomingNotificationHasTherapy() &&
        get(
          /databases/$(database)/documents/terapias/$(request.resource.data.metadata.terapiaId)
        ).data.pacienteUid == request.auth.uid &&
        request.resource.data.metadata.terapeutaId is string &&
        exists(
          /databases/$(database)/documents/therapists/$(request.resource.data.metadata.terapeutaId)
        ) &&
        get(
          /databases/$(database)/documents/therapists/$(request.resource.data.metadata.terapeutaId)
        ).data.uid == request.resource.data.recipientUid;
    }

    function incomingNotificationFromTherapistToPatient() {
      return incomingNotificationHasTherapy() &&
        assignedTherapist(
          get(
            /databases/$(database)/documents/terapias/$(request.resource.data.metadata.terapiaId)
          ).data.terapeutaId
        ) &&
        get(
          /databases/$(database)/documents/terapias/$(request.resource.data.metadata.terapiaId)
        ).data.pacienteUid == request.resource.data.recipientUid;
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if validSelfUserCreate(uid);
      // Self-service profile changes are validated by a callable function.
      allow update: if false;
      allow delete: if false;
    }

    match /account_requests/{requestId} {
      allow read: if isAdmin() || (signedIn() &&
        resource.data.requesterUid == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /payment_audit/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /admin_audit/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /professional_obligations/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /professional_transfers/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /support_requests/{requestId} {
      allow read: if isAdmin() || (
        signedIn() && resource.data.requesterUid == request.auth.uid
      );
      allow write: if false;
    }

    match /profiles/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    match /conversations/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;

      match /messages/{messageId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }

    match /profile_chat_operations/{operationId} {
      allow read: if signedIn() &&
        resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    match /therapists/{therapistId} {
      allow read: if signedIn();
      allow write: if false;

      match /rate_history/{versionId} {
        allow read: if isAdmin() || assignedTherapist(therapistId);
        allow write: if false;
      }
    }

    match /payment_rates/{rateId} {
      allow read: if isAdmin() || userHasRole("psychologist") || (
        signedIn() &&
        currentUserDoc().data.rol in ["psicologo", "psicólogo", "psicóloga"]
      );
      allow write: if false;

      match /versions/{versionId} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }

    match /payment_operations/{operationId} {
      allow read: if isAdmin() || (
        signedIn() && resource.data.patientUid == request.auth.uid
      );
      allow write: if false;
    }

    match /psychologist_requests/{requestId} {
      allow read: if isAdmin() || (
        signedIn() &&
        resource.data.userUid == request.auth.uid
      );
      allow create, update: if false;
      allow delete: if false;
    }

    match /therapist_availability/{slotId} {
      allow read: if signedIn();
      // Agenda policy, ownership and slot concurrency are enforced by Functions.
      allow create, update, delete: if false;
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() &&
        resource.data.recipientUid == request.auth.uid;
      // Domain notifications are emitted idempotently by server operations.
      allow create: if false;
      allow update: if signedIn() &&
        resource.data.recipientUid == request.auth.uid &&
        request.resource.data.recipientUid == resource.data.recipientUid &&
        request.resource.data.actorUid == resource.data.actorUid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["readAt"]);
      allow delete: if false;
    }

    match /citas/{citaId} {
      allow read: if ownsExistingPatientDoc() ||
        ownsExistingTherapistDoc();
      // State transitions and schedule changes are server transactions.
      allow write: if false;
    }

    match /terapias/{terapiaId} {
      allow read: if ownsExistingPatientDoc() ||
        ownsExistingTherapistDoc();
      // Creation and status changes are coordinated with appointments on server.
      allow write: if false;
    }

    match /longitudinal_history/{eventId} {
      allow read: if canReadTherapy(resource.data.terapiaId) ||
        ownsExistingPatientDoc();
      // All domain events, including emotions, are emitted atomically on server.
      // There are no client-authored event types.
      allow write: if false;
    }

    match /exercises/{exerciseId} {
      allow read: if canReadTherapy(resource.data.terapiaId);
      // Assignment, completion and the audit event are one server transaction.
      allow write: if false;
    }

    match /therapy_goals/{goalId} {
      allow read: if canReadTherapy(resource.data.terapiaId);
      allow write: if false;
      match /progress/{entryId} {
        allow read: if canReadTherapy(
          get(/databases/$(database)/documents/therapy_goals/$(goalId)).data.terapiaId
        );
        allow write: if false;
      }
    }

    match /emotional_checkins/{checkinId} {
      allow read: if ownsExistingPatientDoc() ||
        ownsExistingTherapistDoc();
      // Identity, active therapy and its audit event are validated on server.
      allow write: if false;
    }

    match /feddback/{feedbackId} {
      allow create: if signedIn() &&
        request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if false;
    }

    match /feedback/{feedbackId} {
      allow create: if signedIn() &&
        request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
