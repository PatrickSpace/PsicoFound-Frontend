rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function currentUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userHasRole(role) {
      return signedIn() &&
        currentUserDoc().data.roles is list &&
        currentUserDoc().data.roles.hasAny([role]);
    }

    function isAdmin() {
      return signedIn() &&
        (
          userHasRole("admin") ||
          currentUserDoc().data.rol in ["admin", "psicofound-admin"]
        );
    }

    function isPatientRole(role) {
      return role in ["paciente", "patient"];
    }

    function isPatientRoles(roles) {
      return roles is list && roles.hasOnly(["patient"]) && roles.hasAll(["patient"]);
    }

    function validSelfUserCreate(uid) {
      return isOwner(uid) &&
        request.resource.data.id == uid &&
        request.resource.data.email is string &&
        request.resource.data.nombre is string &&
        isPatientRole(request.resource.data.rol) &&
        isPatientRoles(request.resource.data.roles) &&
        request.resource.data.keys().hasOnly([
          "id",
          "email",
          "nombre",
          "rol",
          "roles",
          "createdAt",
          "updatedAt"
        ]);
    }

    function validSelfUserUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "nombre",
          "fechaNacimiento",
          "telefono",
          "updatedAt"
        ]);
    }

    function ownsExistingPatientDoc() {
      return signedIn() && resource.data.pacienteUid == request.auth.uid;
    }

    function ownsIncomingPatientDoc() {
      return signedIn() && request.resource.data.pacienteUid == request.auth.uid;
    }

    function assignedTherapist(therapistId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/therapists/$(therapistId)) &&
        get(/databases/$(database)/documents/therapists/$(therapistId)).data.uid ==
          request.auth.uid;
    }

    function ownsExistingTherapistDoc() {
      return signedIn() && assignedTherapist(resource.data.terapeutaId);
    }

    function ownsIncomingTherapistDoc() {
      return signedIn() &&
        request.resource.data.terapeutaId == resource.data.terapeutaId &&
        assignedTherapist(request.resource.data.terapeutaId);
    }

    function financialAppointmentFieldsUnchanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasNone([
        "bookingId",
        "paymentId",
        "paymentStatus",
        "priceAmount",
        "currency",
        "commissionRuleSnapshot"
      ]);
    }

    function assignedTherapistForTherapy(therapyId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/terapias/$(therapyId)) &&
        assignedTherapist(
          get(/databases/$(database)/documents/terapias/$(therapyId))
            .data.terapeutaId
        );
    }

    function incomingNotificationHasTherapy() {
      return request.resource.data.metadata is map &&
        request.resource.data.metadata.terapiaId is string &&
        request.resource.data.metadata.terapiaId != "" &&
        exists(
          /databases/$(database)/documents/terapias/$(request.resource.data.metadata.terapiaId)
        );
    }

    function incomingNotificationFromPatientToTherapist() {
      return incomingNotificationHasTherapy() &&
        get(
          /databases/$(database)/documents/terapias/$(request.resource.data.metadata.terapiaId)
        ).data.pacienteUid == request.auth.uid &&
        request.resource.data.metadata.terapeutaId is string &&
        exists(
          /databases/$(database)/documents/therapists/$(request.resource.data.metadata.terapeutaId)
        ) &&
        get(
          /databases/$(database)/documents/therapists/$(request.resource.data.metadata.terapeutaId)
        ).data.uid == request.resource.data.recipientUid;
    }

    function incomingNotificationFromTherapistToPatient() {
      return incomingNotificationHasTherapy() &&
        assignedTherapist(
          get(
            /databases/$(database)/documents/terapias/$(request.resource.data.metadata.terapiaId)
          ).data.terapeutaId
        ) &&
        get(
          /databases/$(database)/documents/terapias/$(request.resource.data.metadata.terapiaId)
        ).data.pacienteUid == request.resource.data.recipientUid;
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if validSelfUserCreate(uid) || isAdmin();
      allow update: if isAdmin() || (
        isOwner(uid) &&
        validSelfUserUpdate()
      );
      allow delete: if isAdmin();
    }

    match /profiles/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false;
    }

    match /conversations/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false;

      match /messages/{messageId} {
        allow read: if isOwner(uid) || isAdmin();
        allow write: if false;
      }
    }

    match /therapists/{therapistId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /psychologist_requests/{requestId} {
      allow read: if isAdmin() || (
        signedIn() &&
        resource.data.userUid == request.auth.uid
      );
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /therapist_availability/{slotId} {
      allow read: if signedIn();
      allow create: if signedIn() &&
        request.resource.data.therapistId is string &&
        assignedTherapist(request.resource.data.therapistId) &&
        request.resource.data.status == "available";
      allow update: if (
        assignedTherapist(resource.data.therapistId) &&
        request.resource.data.therapistId == resource.data.therapistId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status",
          "updatedAt"
        ]) &&
        request.resource.data.status in ["available", "closed"]
      );
      allow delete: if false;
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() &&
        resource.data.recipientUid == request.auth.uid;
      allow create: if signedIn() &&
        request.resource.data.actorUid == request.auth.uid &&
        request.resource.data.recipientUid is string &&
        request.resource.data.recipientUid != "" &&
        (
          incomingNotificationFromPatientToTherapist() ||
          incomingNotificationFromTherapistToPatient() ||
          isAdmin()
        );
      allow update: if signedIn() &&
        resource.data.recipientUid == request.auth.uid &&
        request.resource.data.recipientUid == resource.data.recipientUid &&
        request.resource.data.actorUid == resource.data.actorUid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["readAt"]);
      allow delete: if false;
    }

    match /citas/{citaId} {
      allow read: if ownsExistingPatientDoc() ||
        ownsExistingTherapistDoc() ||
        isAdmin();
      allow create: if ownsIncomingPatientDoc();
      allow update: if financialAppointmentFieldsUnchanged() && ((
        ownsExistingPatientDoc() &&
        ownsIncomingPatientDoc() &&
        request.resource.data.pacienteUid == resource.data.pacienteUid
      ) || (
        ownsExistingTherapistDoc() &&
        ownsIncomingTherapistDoc() &&
        request.resource.data.pacienteUid == resource.data.pacienteUid
      ));
      allow delete: if false;
    }

    match /payment_accounts/{psychologistId} {
      allow read: if isAdmin() || (
        signedIn() &&
        resource.data.psychologistUid == request.auth.uid
      );
      allow write: if false;
    }

    match /bookings/{bookingId} {
      allow read: if isAdmin() || (
        signedIn() &&
        (
          resource.data.patientId == request.auth.uid ||
          resource.data.psychologistUid == request.auth.uid
        )
      );
      allow write: if false;
    }

    match /refunds/{refundId} {
      allow read: if isAdmin() || (
        signedIn() &&
        resource.data.requestedByUserId == request.auth.uid
      );
      allow write: if false;
    }

    match /payments/{paymentId} {
      allow read, write: if false;
    }

    match /payment_attempts/{attemptId} {
      allow read, write: if false;
    }

    match /payment_events/{eventId} {
      allow read, write: if false;
    }

    match /ledger_entries/{entryId} {
      allow read, write: if false;
    }

    match /commission_rules/{ruleId} {
      allow read, write: if false;
    }

    match /payment_oauth_states/{stateId} {
      allow read, write: if false;
    }

    match /payment_account_secrets/{psychologistId} {
      allow read, write: if false;
    }

    match /terapias/{terapiaId} {
      allow read: if ownsExistingPatientDoc() ||
        ownsExistingTherapistDoc() ||
        isAdmin();
      allow create: if ownsIncomingPatientDoc();
      allow update: if (
        ownsExistingPatientDoc() &&
        ownsIncomingPatientDoc() &&
        request.resource.data.pacienteUid == resource.data.pacienteUid
      ) || (
        ownsExistingTherapistDoc() &&
        ownsIncomingTherapistDoc() &&
        request.resource.data.pacienteUid == resource.data.pacienteUid
      );
      allow delete: if false;
    }

    match /longitudinal_history/{eventId} {
      allow read: if ownsExistingPatientDoc() ||
        (
          resource.data.terapiaId is string &&
          resource.data.terapiaId != "" &&
          assignedTherapistForTherapy(resource.data.terapiaId)
        ) ||
        isAdmin();
      allow create: if ownsIncomingPatientDoc() ||
        (
          request.resource.data.terapiaId is string &&
          request.resource.data.terapiaId != "" &&
          assignedTherapistForTherapy(request.resource.data.terapiaId)
        );
      allow update, delete: if false;
    }

    match /exercises/{exerciseId} {
      allow read: if ownsExistingPatientDoc() ||
        ownsExistingTherapistDoc() ||
        isAdmin();
      allow create: if (
        ownsIncomingPatientDoc()
      ) || (
        request.resource.data.terapiaId is string &&
        request.resource.data.terapiaId != "" &&
        request.resource.data.terapeutaId is string &&
        assignedTherapist(request.resource.data.terapeutaId) &&
        assignedTherapistForTherapy(request.resource.data.terapiaId)
      );
      allow update: if (
        ownsExistingPatientDoc() &&
        ownsIncomingPatientDoc() &&
        request.resource.data.pacienteUid == resource.data.pacienteUid
      ) || (
        ownsExistingTherapistDoc() &&
        ownsIncomingTherapistDoc() &&
        request.resource.data.pacienteUid == resource.data.pacienteUid
      );
      allow delete: if false;
    }

    match /therapy_goals/{goalId} {
      allow read: if ownsExistingPatientDoc() ||
        ownsExistingTherapistDoc() ||
        isAdmin();
      allow create: if (
        ownsIncomingPatientDoc()
      ) || (
        request.resource.data.terapiaId is string &&
        request.resource.data.terapiaId != "" &&
        request.resource.data.terapeutaId is string &&
        assignedTherapist(request.resource.data.terapeutaId) &&
        assignedTherapistForTherapy(request.resource.data.terapiaId)
      );
      allow update: if (
        ownsExistingPatientDoc() &&
        ownsIncomingPatientDoc() &&
        request.resource.data.pacienteUid == resource.data.pacienteUid
      ) || (
        ownsExistingTherapistDoc() &&
        ownsIncomingTherapistDoc() &&
        request.resource.data.pacienteUid == resource.data.pacienteUid
      );
      allow delete: if false;
    }

    match /emotional_checkins/{checkinId} {
      allow read: if ownsExistingPatientDoc() ||
        ownsExistingTherapistDoc() ||
        isAdmin();
      allow create: if ownsIncomingPatientDoc();
      allow update, delete: if false;
    }

    match /feddback/{feedbackId} {
      allow create: if signedIn() &&
        request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if false;
    }

    match /feedback/{feedbackId} {
      allow create: if signedIn() &&
        request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
