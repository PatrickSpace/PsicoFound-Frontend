# ============================================================
# LUREMS FRONTEND - PRODUCCION
# Copia estas variables en Vercel > Project > Settings > Environment Variables.
# ============================================================
VITE_APP_ENVIRONMENT=production
VITE_APP_BASE_URL=https://app.lurems.lat

# Firebase Web SDK. Mantén authDomain en el dominio emitido por Firebase mientras
# la app use signInWithPopup y se aloje en Vercel.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=psicosaas-3c819.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=psicosaas-3c819
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_FUNCTIONS_REGION=southamerica-east1

# Pagos: solo configuración pública. Nunca agregues secretos con prefijo VITE_.
VITE_PAYMENT_PROVIDER=mercado_pago
VITE_PAYMENT_ENVIRONMENT=production
VITE_PAYMENT_USE_FAKE_PROVIDER=false
VITE_MERCADO_PAGO_PUBLIC_KEY=REEMPLAZAR_PUBLIC_KEY_PRODUCCION
