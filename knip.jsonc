{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  // This test explicitly loads the admin SDK installed in functions/node_modules.
  "ignoreIssues": {
    "tests/paymentRates.integration.test.mjs": ["unlisted"],
    "tests/helpers/followup-fixtures.mjs": ["unlisted"],
    "tests/helpers/admin-sdk.mjs": ["unlisted"],
    "tests/pilot-accounts.integration.test.mjs": ["unlisted"]
  },
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    ".": {
      // Keep runtime entries explicit for --production, even if Vite detects them.
      "entry": ["src/main.js!", "tests/**/*.test.mjs", "tests/run-followup.mjs", "tests/linux-network-child.mjs", "scripts/verify-pilot-config.mjs"],
      "project": ["src/**/*.{js,vue}!", "tests/**/*.mjs"],
      "paths": { "@/*": ["./src/*"] },
      // Firebase CLI is installed separately, as documented in README.
      "ignoreBinaries": ["firebase", "ip", "setpriv"]
    },
    "functions": {
      "entry": ["index.js!", "src/**/*.test.js"],
      "project": ["src/**/*.js!", "!src/**/*.test.js!"],
      "ignoreBinaries": ["firebase"]
    }
  }
}
