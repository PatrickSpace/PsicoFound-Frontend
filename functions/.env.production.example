# ============================================================
# LUREMS FUNCTIONS - PRODUCCION
# Usa este archivo como referencia. No agregues secretos reales al repositorio.
# ============================================================
APP_ENVIRONMENT=production
APP_BASE_URL=https://app.lurems.lat
API_BASE_URL=https://southamerica-east1-psicosaas-3c819.cloudfunctions.net

PAYMENT_PROVIDER=mercado_pago
PAYMENT_ENVIRONMENT=production
PAYMENT_CURRENCY=PEN
PAYMENT_USE_FAKE_PROVIDER=false

MERCADO_PAGO_PUBLIC_KEY=REEMPLAZAR_PUBLIC_KEY_PRODUCCION
MERCADO_PAGO_CLIENT_ID=REEMPLAZAR_CLIENT_ID_PRODUCCION
MERCADO_PAGO_OAUTH_REDIRECT_URI=https://southamerica-east1-psicosaas-3c819.cloudfunctions.net/mercadoPagoOAuthCallback
MERCADO_PAGO_WEBHOOK_URL=https://southamerica-east1-psicosaas-3c819.cloudfunctions.net/mercadoPagoWebhook

# Configura estos valores mediante Firebase Secret Manager, no en este archivo:
# MERCADO_PAGO_ACCESS_TOKEN
# MERCADO_PAGO_CLIENT_SECRET
# MERCADO_PAGO_WEBHOOK_SECRET
# PAYMENT_TOKEN_ENCRYPTION_KEY

BOOKING_HOLD_MINUTES=10
DEFAULT_PLATFORM_COMMISSION_PERCENTAGE=30
DEFAULT_PSYCHOLOGIST_PERCENTAGE=70
PROCESSOR_FEE_BEARER=platform
PAYMENT_RECONCILIATION_ENABLED=true
PAYMENT_RECONCILIATION_SCHEDULE=every 30 minutes

# Estas opciones solo se usan con el proveedor simulado y permanecen inactivas
# porque PAYMENT_USE_FAKE_PROVIDER=false.
FAKE_PAYMENT_DEFAULT_RESULT=approved
FAKE_PAYMENT_WEBHOOK_DELAY_MS=1500
FAKE_PAYMENT_ALLOW_DUPLICATE_WEBHOOK=true
