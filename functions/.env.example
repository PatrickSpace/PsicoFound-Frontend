# No production approval is implied. Leave required policies empty until approved.
ELIGIBILITY_POLICY_JSON=
LEGAL_DOCUMENT_VERSION=
LEGAL_TERMS_URL=
LEGAL_PRIVACY_URL=
PRIVACY_POLICY_JSON=
# Secrets are provisioned in Secret Manager, never here.
# OPENAI_API_KEY: provision it in Secret Manager; never commit its value.

APP_ENV=production
APP_CHECK_MODE=enforce
# Staging only: observe temporarily while validating token metrics.

CHAT_LIMITS_JSON=
AI_USE_APPROVAL_JSON=
PRIMARY_AI_PROVIDER=openai
AI_MODEL=gpt-6-luna
FALLBACK_AI_PROVIDER=

# Real terms require commercial approval. See docs/operations/pilot-payments.md.
COMMERCIAL_POLICY_JSON=

# hybrid: options are local and free text uses approved OpenAI assistance.
SURVEY_INPUT_MODE=hybrid

# Automatic payment confirmation is enabled only after provider and webhook verification.
# Non-secret settings; publicOrigin must be the real HTTPS app origin.
# PAYMENT_AUTOMATION_JSON={"enabled":true,"mode":"production","collectorId":"REPLACE_WITH_MERCHANT_ID","publicOrigin":"https://app.lurems.lat"}
PAYMENT_AUTOMATION_JSON={"enabled":false}
# MERCADOPAGO_ACCESS_TOKEN and MERCADOPAGO_WEBHOOK_SECRET: Secret Manager only.
# mode=test is restricted to an isolated APP_ENV=staging or demo emulator.

# Application AI budget: set approved monthly USD cap and account/session allocations.
# See src/ai/ADMISSION_COST_CONTROLS.md. Empty configuration uses guided continuation.
AI_ADMISSION_LIMITS_JSON=
