# No production approval is implied. Leave required policies empty until approved.
ELIGIBILITY_POLICY_JSON=
LEGAL_DOCUMENT_VERSION=
LEGAL_TERMS_URL=
LEGAL_PRIVACY_URL=
PRIVACY_POLICY_JSON=
# Secrets are provisioned in Secret Manager, never here.
# OPENAI_API_KEY: provision it in Secret Manager; never commit its value.

APP_ENV=production
APP_CHECK_MODE=enforce
# Staging only: observe temporarily while validating token metrics.

CHAT_LIMITS_JSON=
AI_USE_APPROVAL_JSON=
PRIMARY_AI_PROVIDER=openai
AI_MODEL=gpt-6-luna
FALLBACK_AI_PROVIDER=

# Real terms require commercial approval. See docs/operations/pilot-payments.md.
COMMERCIAL_POLICY_JSON=

# hybrid: options are local and free text uses approved OpenAI assistance.
SURVEY_INPUT_MODE=hybrid

# Automatic payment confirmation is enabled only after provider and webhook verification.
# Non-secret settings; publicOrigin must be the real HTTPS app origin.
# PAYMENT_AUTOMATION_JSON={"enabled":true,"mode":"production","collectorId":"REPLACE_WITH_MERCHANT_ID","publicOrigin":"https://app.lurems.lat"}
PAYMENT_AUTOMATION_JSON={"enabled":false}
# MERCADOPAGO_ACCESS_TOKEN and MERCADOPAGO_WEBHOOK_SECRET: Secret Manager only.
# mode=test is restricted to an isolated APP_ENV=staging or demo emulator.

# Application AI budget: set approved monthly USD cap and account/session allocations.
# See src/ai/ADMISSION_COST_CONTROLS.md. Empty configuration uses guided continuation.
AI_ADMISSION_LIMITS_JSON=

# Optional automatic payment provider configuration.
APP_ENVIRONMENT=development
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:5001/PROJECT_ID/southamerica-east1
ENFORCE_APP_CHECK=false
ENABLE_QA_SEED=false
QA_ADMIN_UIDS=
PAYMENT_PROVIDER=culqi
PAYMENT_ENVIRONMENT=sandbox
PAYMENT_CURRENCY=PEN
PAYMENT_USE_FAKE_PROVIDER=true
CULQI_PUBLIC_KEY=pk_test_REEMPLAZAR
CULQI_SECRET_KEY=sk_test_REEMPLAZAR
MERCADO_PAGO_PUBLIC_KEY=TEST-REEMPLAZAR_PUBLIC_KEY
MERCADO_PAGO_ACCESS_TOKEN=TEST-REEMPLAZAR_ACCESS_TOKEN
MERCADO_PAGO_CLIENT_ID=REEMPLAZAR_CLIENT_ID
MERCADO_PAGO_CLIENT_SECRET=REEMPLAZAR_CLIENT_SECRET
MERCADO_PAGO_WEBHOOK_SECRET=REEMPLAZAR_WEBHOOK_SECRET
MERCADO_PAGO_OAUTH_REDIRECT_URI=http://localhost:5001/PROJECT_ID/southamerica-east1/mercadoPagoOAuthCallback
MERCADO_PAGO_WEBHOOK_URL=http://localhost:5001/PROJECT_ID/southamerica-east1/mercadoPagoWebhook
PAYMENT_TOKEN_ENCRYPTION_KEY=REEMPLAZAR_CLAVE_DE_CIFRADO
BOOKING_HOLD_MINUTES=10
DEFAULT_PLATFORM_COMMISSION_PERCENTAGE=30
DEFAULT_PSYCHOLOGIST_PERCENTAGE=70
PROCESSOR_FEE_BEARER=platform
PAYMENT_RECONCILIATION_ENABLED=true
PAYMENT_RECONCILIATION_SCHEDULE=every 30 minutes
FAKE_PAYMENT_DEFAULT_RESULT=approved
FAKE_PAYMENT_WEBHOOK_DELAY_MS=1500
FAKE_PAYMENT_ALLOW_DUPLICATE_WEBHOOK=true
