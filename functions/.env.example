APP_ENVIRONMENT=development
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:5001/PROJECT_ID/southamerica-east1

PAYMENT_PROVIDER=mercado_pago
PAYMENT_ENVIRONMENT=sandbox
PAYMENT_CURRENCY=PEN
PAYMENT_USE_FAKE_PROVIDER=true

MERCADO_PAGO_PUBLIC_KEY=TEST-REEMPLAZAR_PUBLIC_KEY
MERCADO_PAGO_ACCESS_TOKEN=TEST-REEMPLAZAR_ACCESS_TOKEN
MERCADO_PAGO_CLIENT_ID=REEMPLAZAR_CLIENT_ID
MERCADO_PAGO_CLIENT_SECRET=REEMPLAZAR_CLIENT_SECRET
MERCADO_PAGO_WEBHOOK_SECRET=REEMPLAZAR_WEBHOOK_SECRET
MERCADO_PAGO_OAUTH_REDIRECT_URI=http://localhost:5001/PROJECT_ID/southamerica-east1/mercadoPagoOAuthCallback
MERCADO_PAGO_WEBHOOK_URL=http://localhost:5001/PROJECT_ID/southamerica-east1/mercadoPagoWebhook
PAYMENT_TOKEN_ENCRYPTION_KEY=REEMPLAZAR_CLAVE_DE_CIFRADO

BOOKING_HOLD_MINUTES=10
DEFAULT_PLATFORM_COMMISSION_PERCENTAGE=30
DEFAULT_PSYCHOLOGIST_PERCENTAGE=70
PROCESSOR_FEE_BEARER=platform
PAYMENT_RECONCILIATION_ENABLED=true
PAYMENT_RECONCILIATION_SCHEDULE=every 30 minutes

FAKE_PAYMENT_DEFAULT_RESULT=approved
FAKE_PAYMENT_WEBHOOK_DELAY_MS=1500
FAKE_PAYMENT_ALLOW_DUPLICATE_WEBHOOK=true
