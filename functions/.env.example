# Gemini sigue siendo el proveedor por defecto. No hay cobros API en fase 1.
PRIMARY_AI_PROVIDER=gemini
FALLBACK_AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash
FALLBACK_AI_MODEL=gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash

# Produccion: firebase functions:secrets:set GEMINI_API_KEY
# Emulador: configurar GEMINI_API_KEY en .secret.local, nunca versionarlo.
# No colocar credenciales de Mercado Pago: la fase 1 solo almacena links HTTPS.
